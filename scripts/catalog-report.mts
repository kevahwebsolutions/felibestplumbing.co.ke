// Generates docs/catalog-report.md and docs/catalog-images.md from the committed catalogue data and image metadata.
// Usage: npx tsx scripts/catalog-report.mts
import fs from 'node:fs';
import { CATALOG_PRODUCTS } from '../src/data/catalog-products.ts';
import meta from '../src/data/catalog-image-meta.json' with { type: 'json' };

const M = meta as Record<string, { width: number; height: number; bytes: number; source: string }>;
const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;

// ---------- catalog-report.md ----------
const rows = CATALOG_PRODUCTS.map((p) => {
  const primary = M[p.images[0]!.file]!;
  return `| ${p.slug} | ${p.name} | ${p.categorySlug} | KES ${p.price.toLocaleString('en-KE')} | ${p.images.length} | ${primary.width}x${primary.height} | ${p.seoTitle.length} | ${p.description.length} | ${p.needsReview ? 'yes' : 'no'} |`;
});
fs.writeFileSync(
  'docs/catalog-report.md',
  `# Catalogue report

Generated by \`npx tsx scripts/catalog-report.mts\` from \`src/data/catalog-products.ts\` and \`src/data/catalog-image-meta.json\`.
Title length is the full page title. Description length is the product description in characters.

| slug | name | category | price | images | primary image px | title length | description length | needsReview |
| --- | --- | --- | --- | --- | --- | --- | --- | --- |
${rows.join('\n')}

All 16 primary images are below 600 px on the short side because the source files are screen captures. See docs/catalog-images.md.
`,
);

// ---------- catalog-images.md ----------
const included = new Set(CATALOG_PRODUCTS.flatMap((p) => p.images.map((i) => i.source)));
const EXCLUDED: [string, string][] = [
  ['1-milano-modern-shower-1.jpg', 'Flat-lay product photo carrying an "AI generated" watermark in the bottom corner (not part of the product); also not a photo of the stock on sale.'],
  ['1-milano-modern-shower-2.jpg', 'Same flat-lay with the "AI generated" watermark.'],
  ['4-front-load-washing-machine-cover-1.jpg', 'Handwritten price "800" over the packaging. Photo 2 (also marked) is kept, see exceptions.'],
  ['6-front-load-washing-machine-cover-1.jpg', 'Handwritten price "1,000" over the packaging; a clean photo of the fitted cover exists.'],
  ['7-zipped-laundry-mesh-bags-1.jpg', 'Handwritten price and pack count over the bags; a clean photo exists.'],
  ['7-zipped-laundry-mesh-bags-3.jpg', 'Stock-style catalogue image (white background, seven bags of different sizes) that does not clearly show the bags sold.'],
  ['8-drawstring-laundry-mesh-bags-1.jpg', 'Handwritten price and pack count over the bags; a clean photo exists.'],
  ['8-drawstring-laundry-mesh-bags-3.jpg', 'Stock-style lifestyle image with overlaid marketing text ("Full Solution for Laundry"), not the shop\'s own stock.'],
  ['9-front-load-washing-machine-cover-1.jpg', 'Handwritten price "1,200" over the packaging; a clean photo of the fitted cover exists.'],
  ['13-washing-machine-outlet-pipe-3m-1.jpg', 'Handwritten price over the hose; a clean photo exists.'],
  ['14-washing-machine-inlet-pipe-3m-1.jpg', 'Handwritten price over the label; a cleaner photo exists.'],
  ['16-drum-cleaning-tablets-1.jpg', 'Handwritten price "700" over the box; a clean photo of the box front exists.'],
].filter(([, why]) => why) as [string, string][];

const keptRows = CATALOG_PRODUCTS.flatMap((p) =>
  p.images.map((im, i) => {
    const m = M[im.file]!;
    const short = Math.min(m.width, m.height);
    return `| ${im.file} | ${p.slug} | ${i === 0 ? 'primary' : `#${i + 1}`} | ${im.source} | ${m.width}x${m.height} | ${kb(m.bytes)} | ${short < 600 ? 'yes' : 'no'} |`;
  }),
);
const sourceCount = fs.existsSync('catalog-import/images') ? fs.readdirSync('catalog-import/images').length : 41;
fs.writeFileSync(
  'docs/catalog-images.md',
  `# Catalogue images

Source: ${sourceCount} screen captures from WhatsApp Desktop (the app offers no download), 370 to 500 px wide. Every image was opened and inspected.
Processing (\`npm run catalog:images\`, \`scripts/process-catalog-images.mts\`): auto-orient, no upscaling at all (so the 1.5x limit is never reached), long edge capped at 1600 px, WebP quality 80. No border trim was applied: the captures are already cropped to the picture and have no uniform borders, so trimming could only cut into the product.
Kept ${included.size} of ${sourceCount} images. Excluded ${EXCLUDED.length}.

## Kept images

| file | product | position | source file | final px | size | primary or other short side under 600 px |
| --- | --- | --- | --- | --- | --- | --- |
${keptRows.join('\n')}

Every kept image is under 600 px on its short side (they are all screen captures). Replace each with the supplier's original through Admin, Products, Images. Nothing was sharpened or upscaled to hide this.

## Excluded images

| source file | reason |
| --- | --- |
${EXCLUDED.map(([f, r]) => `| ${f} | ${r} |`).join('\n')}

## Exceptions: kept although a price mark is visible

A rule of "no text that is not part of the product" would leave these products with no photo at all, and a product page without a photo is worse than one with a small price mark. They are flagged for the owner to replace first.

- front-load-washing-machine-cover-kes-800: the only photo shows an overlaid "@800" mark. It matches the current price. The other photo has handwriting.
- washing-machine-tap: single photo, small handwritten "650" on the tap.
- washing-machine-scent-beads (4 photos): "1000" handwritten on every bottle label.
- colour-and-dirt-catcher: front photo has a handwritten "1000" over the box; the back photo is clean but does not show the product front.
- washing-machine-inlet-pipe-3m: faint handwriting on the card label.

## Other notes

- Handwritten pack counts ("6 pcs", "4 pcs") appear on the zipped and drawstring bag photos. They are not in the catalogue data, so they are not used in any text. Confirm them with the supplier.
- Photo 3 of rows 7 and 8 (stock-style) was excluded because it does not clearly show the product sold.
- The two Milano flat-lay photos are excluded; the single kept photo shows the shower installed in a bathroom.
`,
);
console.log('Wrote docs/catalog-report.md and docs/catalog-images.md');
