{
  "name": "felibest-plumbing",
  "version": "1.0.0",
  "private": true,
  "description": "Felibest Plumbing - clay-styled website, shop, admin and analytics",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "seed:demo-analytics": "tsx scripts/seed-demo-analytics.ts",
    "images": "node scripts/optimize-images.mjs",
    "check:redirects": "tsx scripts/check-redirects.mts",
    "check:site": "tsx scripts/check-site.mts",
    "rollup": "tsx scripts/rollup.ts",
    "screens": "tsx scripts/screenshots.mts",
    "e2e:serve": "npm run db:migrate && npm run db:seed && next dev --port 3100"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-table": "8.21.3",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "14.14.0",
    "iron-session": "9.1.0",
    "lenis": "1.3.27",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "recharts": "3.11.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "ua-parser-js": "2.0.10",
    "yet-another-react-lightbox": "3.33.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ua-parser-js": "0.7.39",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
