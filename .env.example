# Copy to .env (never commit .env). Next.js and the CLI scripts both read it.

# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://felibestplumbing.co.ke

# SQLite database file and image upload folder. Use absolute paths on the server.
DATABASE_PATH=./data/felibest.db
UPLOAD_DIR=./data/uploads

# Admin account created by `npm run db:seed`. A password change is forced on first login.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe-Use-A-Long-Password-1

# Session cookie encryption key: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret mixed into the daily visitor hash used by first-party analytics.
ANALYTICS_SALT=

# Web3Forms access key. ROTATE the old key that was hard-coded in the legacy HTML.
WEB3FORMS_ACCESS_KEY=

# Set to 1 only when testing the production build over plain http on localhost.
INSECURE_COOKIES=

# ---------------------------------------------------------------------------
# Optional: automatic WhatsApp message to the owner (Meta WhatsApp Cloud API)
# ---------------------------------------------------------------------------
# Without these, orders still work: the customer's browser opens WhatsApp with the order
# ready to send, and every order is saved in the database and shown in Admin, Orders.
# Set ALL THREE of the next variables to also have the server message the owner by itself
# the moment an order is saved. See README, "Enable automatic WhatsApp (Cloud API)".

# Permanent system-user access token from Meta Business settings. Treat it like a password.
WHATSAPP_CLOUD_TOKEN=
# The Phone number ID shown in Meta, WhatsApp, API setup (a long number, not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# The owner's WhatsApp number that receives order alerts, digits with country code, e.g. 254798174201.
WHATSAPP_OWNER_NUMBER=
# Name of an approved message template (one body variable). Used when the owner has not messaged the
# business number in the last 24 hours, because Meta only allows free-form messages inside that window.
WHATSAPP_TEMPLATE_NAME=
# Language code of the template, default en.
WHATSAPP_TEMPLATE_LANGUAGE=en
